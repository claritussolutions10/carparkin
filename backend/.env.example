PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=carparkin

JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=604800

# Optional — used for password-reset/verify-email links. Defaults to
# http://localhost:5173 if unset.
FRONTEND_URL=http://localhost:5173

# Optional — if unset, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Carparkin.in <no-reply@carparkin.in>"

# Razorpay — test-mode keys from Dashboard > Settings > API Keys.
# RAZORPAY_WEBHOOK_SECRET is set when you create the webhook (Dashboard > Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
